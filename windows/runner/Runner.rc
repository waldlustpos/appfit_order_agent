/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
//
// Brand axis - see APPFIT_BRAND_MAMMOTH below. Requires
// windows/runner/resources/app_icon_mammoth.ico (tool/gen_brand_icon.dart).
#if defined(APPFIT_BRAND_MAMMOTH)
IDI_APP_ICON            ICON                    "resources\\app_icon_mammoth.ico"
#else
IDI_APP_ICON            ICON                    "resources\\app_icon.ico"
#endif


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

#if defined(FLUTTER_VERSION)
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_STRING "1.0.0"
#endif

// Product identity (unified across korea and japan - region never affects
// this). ProductName drives the per-user data directory chosen by
// path_provider_windows (%APPDATA%\CompanyName\ProductName). CompanyName
// (below) is intentionally NOT branched - a different ProductName alone
// already isolates the SharedPreferences sandbox per brand.
// Keep ASCII only.
//
// Brand axis - see windows/CMakeLists.txt (APPFIT_BRAND_MAMMOTH). Common
// keeps the exact legacy name so existing japan Windows installs retain their
// SharedPreferences and app-support files (no regression).
#if defined(APPFIT_BRAND_MAMMOTH)
#define APPFIT_PRODUCT_NAME "appfit_order_agent_mammoth"
#define APPFIT_EXE_NAME     "appfit_order_agent_mammoth.exe"
#else
#define APPFIT_PRODUCT_NAME "appfit_order_agent"
#define APPFIT_EXE_NAME     "appfit_order_agent.exe"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "co.kr.waldlust.order" "\0"
            VALUE "FileDescription", APPFIT_PRODUCT_NAME "\0"
            VALUE "FileVersion", VERSION_AS_STRING "\0"
            VALUE "InternalName", APPFIT_PRODUCT_NAME "\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 co.kr.waldlust.order. All rights reserved." "\0"
            VALUE "OriginalFilename", APPFIT_EXE_NAME "\0"
            VALUE "ProductName", APPFIT_PRODUCT_NAME "\0"
            VALUE "ProductVersion", VERSION_AS_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

#endif    // English (United States) resources
